[Unit]
Description = AdGuardHome DNS
After = network-online.target tailscaled.service
Wants = network-online.target

[Container]
Image = docker.io/adguard/adguardhome:latest
ContainerName = adguardhome
MemoryMax = 200m
Network = host
Volume = /data/container/adguardhome/container-data/work:/opt/adguardhome/work
Volume = /data/container/adguardhome/container-data/conf:/opt/adguardhome/conf

[Service]
Restart = always

[Install]
WantedBy = multi-user.target
